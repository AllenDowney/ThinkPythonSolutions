# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# jupytext working copies of the chapters.
# These are kept on disk deliberately: a Jupyter session saving over a chapter
# can revert edits, and the markdown is the recovery copy. They are not source
# -- the .ipynb files are -- so they stay out of version control.
# ---------------------------------------------------------------------------
soln/chap*.md

# ---------------------------------------------------------------------------
# Support files the notebooks download from the ThinkPython repo at run time.
# The canonical copies are tracked at the top level of ThinkPython.
# (soln/thinkpython.py and soln/structshape.py are tracked here for now.)
# ---------------------------------------------------------------------------
soln/diagram.py
soln/jupyturtle.py
soln/words.txt
soln/photos.zip
soln/photos/

# ---------------------------------------------------------------------------
# Texts downloaded from Project Gutenberg, and the files the notebooks derive
# from them. Chapters 8, 11 and 12 re-download these on every test run.
# ---------------------------------------------------------------------------
soln/pg*.txt
soln/dr_jekyll*.txt
soln/camel-spotting-book.txt
soln/numbers.txt
soln/output.txt

# ---------------------------------------------------------------------------
# dbm / shelve databases created by the chapters on dictionaries and files
# ---------------------------------------------------------------------------
soln/*.bak
soln/*.dat
soln/*.dir

# ---------------------------------------------------------------------------
# Photo metadata built by the chapter on walking directories
# ---------------------------------------------------------------------------
soln/photo_info/

# ---------------------------------------------------------------------------
# LaTeX build output. The source in latex/ is Makefile, build.sh, main.tex,
# settings.tex, front_matter.tex, back_matter.tex and the *.py helpers --
# everything below is regenerated by latex/build.sh.
# ---------------------------------------------------------------------------
latex/chap*.ipynb
latex/chap*.md
latex/chap*.tex
latex/*.nbconvert.*
latex/*_files/
latex/main.aux
latex/main.log
latex/main.pdf
latex/main.toc

# Copies of support files and data the latex build pulls in alongside soln/
latex/diagram.py
latex/jupyturtle.py
latex/structshape.py
latex/thinkpython.py
latex/words.txt
latex/photos.zip
latex/photos/
latex/photo_info/
latex/pg*.txt
latex/dr_jekyll*.txt
latex/camel-spotting-book.txt
latex/*.bak
latex/*.dat
latex/*.dir
